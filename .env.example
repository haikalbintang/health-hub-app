# Base URL of the Flask backend API.
# Must be reachable from the Next.js server (the /api proxy runs server-side),
# not just from the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Supabase Storage — currently hardcoded in src/supabase/supabase.js.
# Add these here and switch the client over to read from process.env.
# The `anon` key is safe to expose to the browser; never put the service_role key here.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
